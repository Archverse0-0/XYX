{
  "name": "xyx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test packages/shared/test/*.test.ts packages/risk-engine/test/*.test.ts packages/graph-intelligence/test/*.test.ts packages/erc8004/test/*.test.ts apps/provider/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test --root packages/contracts -vvv",
    "build:contracts": "forge build --root packages/contracts",
    "api": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "witness": "tsx --env-file-if-exists=.env.witness apps/witness/src/main.ts",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "doctor": "tsx scripts/doctor.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "circle:create-wallet": "tsx --env-file-if-exists=.env scripts/create-circle-wallet.ts",
    "subgraph:render": "node scripts/render-subgraph.mjs",
    "subgraph:codegen": "npm run subgraph:render && (cd packages/subgraph && graph codegen subgraph.yaml)",
    "subgraph:build": "npm run subgraph:render && (cd packages/subgraph && graph build subgraph.yaml)",
    "verify:live": "tsx --env-file-if-exists=.env scripts/verify-live.ts",
    "verify:ipfs-live": "tsx --env-file-if-exists=.env.witness scripts/verify-ipfs-live.ts",
    "verify:protected-job": "tsx --env-file-if-exists=.env.witness scripts/verify-protected-job.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^9.6.0",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "3.8.1",
    "@privy-io/wagmi": "latest",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-query": "^5.90.0",
    "ajv": "^8.17.1",
    "fastify": "^5.6.0",
    "gsap": "3.15.0",
    "ipaddr.js": "^2.5.0",
    "lenis": "1.3.26",
    "next": "^16.3.4",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.185.1",
    "undici": "^8.10.2",
    "viem": "^2.37.0",
    "wagmi": "^3.7.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
