specVersion: 1.2.0
schema:
  file: ./schema.graphql
dataSources:
  - kind: ethereum
    name: XYXEvidenceRegistry
    network: arc-testnet
    source:
      address: "__EVIDENCE_REGISTRY_ADDRESS__"
      abi: XYXEvidenceRegistry
      startBlock: __EVIDENCE_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [Endpoint, Receipt]
      abis: [{name: XYXEvidenceRegistry, file: ./abis/XYXEvidenceRegistry.json}]
      eventHandlers:
        - event: ReceiptAnchored(indexed bytes32,indexed bytes32,indexed bytes32,address,uint128,bytes32,bytes32,bytes32,bytes32,bytes32,bytes32,uint32,uint16,uint8,uint64,address,uint256,string)
          handler: handleReceiptAnchored
      file: ./src/evidence.ts
  - kind: ethereum
    name: XYXEvaluator
    network: arc-testnet
    source:
      address: "__EVALUATOR_ADDRESS__"
      abi: XYXEvaluator
      startBlock: __EVALUATOR_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [Job]
      abis: [{name: XYXEvaluator, file: ./abis/XYXEvaluator.json}]
      eventHandlers:
        - event: JobVerdictExecuted(indexed bytes32,indexed uint256,uint8,bytes32,bytes32,indexed address)
          handler: handleVerdict
      file: ./src/evaluator.ts
  - kind: ethereum
    name: AgenticCommerce
    network: arc-testnet
    source:
      address: "0x0747EEf0706327138c69792bF28Cd525089e4583"
      abi: AgenticCommerce
      startBlock: __ERC8183_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [Job]
      abis: [{name: AgenticCommerce, file: ./abis/AgenticCommerce.json}]
      eventHandlers:
        - event: JobCreated(indexed uint256,indexed address,indexed address,address,uint256,address)
          handler: handleJobCreated
        - event: BudgetSet(indexed uint256,uint256)
          handler: handleBudgetSet
        - event: JobFunded(indexed uint256,indexed address,uint256)
          handler: handleJobFunded
        - event: JobSubmitted(indexed uint256,indexed address,bytes32)
          handler: handleJobSubmitted
        - event: JobCompleted(indexed uint256,indexed address,bytes32)
          handler: handleJobCompleted
        - event: JobRejected(indexed uint256,indexed address,bytes32)
          handler: handleJobRejected
        - event: JobExpired(indexed uint256)
          handler: handleJobExpired
      file: ./src/commerce.ts
  - kind: ethereum
    name: ERC8004Identity
    network: arc-testnet
    source:
      address: "0x8004A818BFB912233c491871b3d84c89A494BD9e"
      abi: IdentityRegistry
      startBlock: __ERC8004_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [AgentIdentity]
      abis: [{name: IdentityRegistry, file: ./abis/IdentityRegistry.json}]
      eventHandlers:
        - event: Registered(indexed uint256,string,indexed address)
          handler: handleRegistered
      file: ./src/identity.ts
  - kind: ethereum
    name: ERC8004Validation
    network: arc-testnet
    source:
      address: "0x8004Cb1BF31DAf7788923b405b754f57acEB4272"
      abi: ValidationRegistry
      startBlock: __ERC8004_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [Validation]
      abis: [{name: ValidationRegistry, file: ./abis/ValidationRegistry.json}]
      eventHandlers:
        - event: ValidationResponse(indexed address,indexed uint256,indexed bytes32,uint8,string,bytes32,string)
          handler: handleValidationResponse
      file: ./src/validation.ts
  - kind: ethereum
    name: ERC8004Reputation
    network: arc-testnet
    source:
      address: "0x8004B663056A597Dffe9eCcC1965A193B7388713"
      abi: ReputationRegistry
      startBlock: __ERC8004_START_BLOCK__
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.9
      language: wasm/assemblyscript
      entities: [Feedback]
      abis: [{name: ReputationRegistry, file: ./abis/ReputationRegistry.json}]
      eventHandlers:
        - event: NewFeedback(indexed uint256,indexed address,uint64,int128,uint8,indexed string,string,string,string,string,bytes32)
          handler: handleNewFeedback
        - event: FeedbackRevoked(indexed uint256,indexed address,indexed uint64)
          handler: handleFeedbackRevoked
      file: ./src/reputation.ts
